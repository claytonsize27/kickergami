DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
KICKERGAMI_DATA_SOURCE=nflverse_pbp
KICKERGAMI_CURRENT_CSV=
KICKERGAMI_NFLVERSE_SEASON=
KICKERGAMI_NFLVERSE_CACHE_DIR=/tmp/kickergami-nflverse-cache
KICKERGAMI_NFLVERSE_REFRESH=true
KICKERGAMI_NFLVERSE_PBP_URL_TEMPLATE=https://github.com/nflverse/nflverse-data/releases/download/pbp/play_by_play_{season}.csv.gz
KICKERGAMI_SKIP_OFFSEASON=true
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
TWEETS_ENABLED=false
DRY_RUN=true

